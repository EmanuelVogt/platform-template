{
  "name": "platform-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,cjs,js,jsx,json,yml,yaml,css}\"",
    "contract": "pnpm --filter api contract && pnpm --filter @platform/api-client generate",
    "contract:consumers": "node scripts/contract-consumers.mjs",
    "contract:diff": "node scripts/contract-diff.mjs",
    "tokens:report": "node scripts/token-report.mjs",
    "dispatch:report": "node scripts/dispatch-report.mjs",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.mts --coverage",
    "test:int": "vitest run --config vitest.integration.mts --project api-int",
    "test:e2e": "vitest run --config vitest.integration.mts --project api-e2e",
    "test:db": "vitest run --config vitest.integration.mts",
    "check": "turbo lint typecheck",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "template:smoke": "node scripts/template-smoke.mjs",
    "platform": "node scripts/platform/cli.mjs",
    "catalog:check": "node scripts/platform/catalog-check.mjs",
    "catalog:lint": "node scripts/platform/catalog-lint.mjs",
    "catalog:typecheck": "node scripts/platform/catalog-stage.mjs",
    "test:scripts": "node --test scripts/platform/__tests__/*.test.mjs",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "semver": "^7.8.1",
    "turbo": "^2.10.2",
    "typescript": "~6",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "js-yaml": "^4.3.1",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "minimatch@3>brace-expansion": "^1.1.18",
      "minimatch@10>brace-expansion": "^5.0.9",
      "postcss>nanoid": "^3.3.18",
      "@scalar/types>nanoid": "^5.1.16",
      "postcss": "^8.5.18",
      "vite": "^8.0.16",
      "undici": "^7.29.0"
    }
  }
}
