{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*.spec.ts",
    "**/*.int-spec.ts",
    "**/*.e2e-spec.ts",
    "**/*.fixture.ts",
    "**/testing/**",
    "**/__e2e__/**",
    "**/parity/**",
    "**/__parity__/**"
  ]
}
