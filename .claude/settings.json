{
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline.mjs\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pending-advisories.mjs\"",
            "statusMessage": "Checking pending advisories"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch-only-in-worktree.mjs\"",
            "statusMessage": "Checking branch × worktree"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-huge-reads.mjs\"",
            "statusMessage": "Checking read size"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/edit-reminders.mjs\"",
            "statusMessage": "Recalling repo rules"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/specs-in-english.mjs\"",
            "statusMessage": "Checking spec artifact language"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-stay-lean.mjs\"",
            "statusMessage": "Checking doc growth and rationale prose"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-stay-lean.mjs\"",
            "statusMessage": "Checking shell writes into docs"
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/delegate-to-subagent.mjs\"",
            "statusMessage": "Checking whether this goes to a subagent"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-model-required.mjs\"",
            "statusMessage": "Checking the subagent tier"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-log.mjs\" dispatch",
            "statusMessage": "Logging the dispatch"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-log.mjs\" start",
            "statusMessage": "Logging the subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dispatch-log.mjs\" stop",
            "statusMessage": "Logging the subagent run"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reinject-tripwires.mjs\"",
            "statusMessage": "Reinforcing tripwires in a long session"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context-checkpoint.mjs\"",
            "statusMessage": "Measuring the session context"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/delegate-to-subagent.mjs\" reset",
            "statusMessage": "Resetting the turn's navigation quota"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pending-advisories.mjs\"",
            "statusMessage": "Checking pending advisories"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/comment-policy.mjs\"",
            "statusMessage": "Checking added comments"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contract-enum.mjs\"",
            "statusMessage": "Checking contract enum"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contract-consumers.mjs\"",
            "statusMessage": "Mapping contract consumers"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wave-plan-check.mjs\"",
            "statusMessage": "Checking the wave plan"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kill-orphan-dev-servers.mjs\"",
            "statusMessage": "Terminating orphan dev servers"
          }
        ]
      }
    ]
  }
}
