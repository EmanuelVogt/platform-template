{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [{ "include": "**/*.hbs", "outDir": "dist" }],
    "watchAssets": true,
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "ignore": [
          "**/*.spec.ts",
          "**/*.int-spec.ts",
          "**/*.e2e-spec.ts",
          "**/*.fixture.ts",
          "**/testing/**",
          "**/__e2e__/**",
          "**/parity/**",
          "**/__parity__/**"
        ]
      }
    }
  }
}
