# URL base da API (sem sufixo /v1 — os paths gerados já o incluem).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Nome do app (título da página) e idioma (<html lang>). Sem estas variáveis
# o app usa "Platform" / "pt-BR" — o comportamento de hoje.
NEXT_PUBLIC_APP_NAME=Platform
NEXT_PUBLIC_LOCALE=pt-BR
