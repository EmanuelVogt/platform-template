{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm typecheck && pnpm build:emit",
    "build:emit": "nest build",
    "dev": "concurrently -n nest,types -c green,yellow \"nest start --watch\" \"tsc --noEmit --watch --preserveWatchOutput\"",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/seeds/run.ts",
    "db:bootstrap": "ts-node src/seeds/bootstrap-master.ts",
    "db:migrate:run": "ts-node src/db/migrate.ts",
    "db:check:journal": "ts-node src/db/check-journal.ts",
    "outbox:replay": "ts-node src/db/outbox-replay.ts",
    "contract": "ts-node src/openapi/export-openapi.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:all": "bash scripts/coverage-all.sh",
    "test:int": "jest --config ./test/jest-integration.json",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "pnpm test && pnpm test:int && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@scalar/nestjs-api-reference": "^1.1.20",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "argon2": "^0.44.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "multer": "^2.1.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2",
    "resend": "^6.12.4",
    "rxjs": "^7",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/multer": "^2.1.0",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "jest": "^29",
    "nyc": "^18.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3",
    "source-map-support": "^0.5",
    "supertest": "^7",
    "testcontainers": "^12.0.1",
    "ts-loader": "^9",
    "ts-node": "^10",
    "tsconfig-paths": "^4",
    "typescript": "~6"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/../test/setup/unit-env.ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.int-spec\\.ts$",
      "\\.e2e-spec\\.ts$"
    ],
    "passWithNoTests": true,
    "maxWorkers": 4,
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.int-spec.ts",
      "!**/*.e2e-spec.ts",
      "!**/*.d.ts",
      "!**/main.ts",
      "!**/product-permission-catalogs.ts",
      "!**/product-access-profiles.ts",
      "!**/product-upload-profiles.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 43,
        "branches": 35,
        "functions": 40,
        "lines": 45
      }
    },
    "testEnvironment": "node",
    "coverageProvider": "v8"
  }
}
