# Copie para .env e ajuste. O boot valida via Zod (fail-fast em variável faltando/inválida).
NODE_ENV=development
PORT=3222
LOG_LEVEL=debug

# Postgres dev existente (container postgres_dev). O kernel isola tudo no
# schema _kernel, sem colidir com o resto do devdb.
DATABASE_URL=postgres://devuser:devpassword@localhost:5432/devdb
DATABASE_POOL_MAX=10
# disable em dev; require em prod (TLS com rejectUnauthorized).
DATABASE_SSL=disable
# Timeouts do pool (ms): conexão, ocioso e teto por query.
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Rede de segurança abaixo do código: transação aberta e ociosa além deste teto é
# encerrada pelo Postgres (statement_timeout não cobre esse estado). Mesmo valor
# do statement timeout.
DATABASE_IDLE_IN_TX_TIMEOUT_MS=30000
# Teto da fila do pool: aquisições em espera acima disso são recusadas na hora,
# em vez de enfileirar. Default 20 = 2x DATABASE_POOL_MAX.
DATABASE_POOL_MAX_WAITING=20
# Acima deste tempo de espera por conexão sai o log db.pool_acquire_slow.
DATABASE_POOL_ACQUIRE_WARN_MS=500

OTEL_SERVICE_NAME=api
SERVICE_VERSION=0.0.1
# Vazio = SDK ativo sem exporter OTLP. Spans alimentam logs via traceId, sem backend visual.
# Dev usa ConsoleSpanExporter automaticamente.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- auth: rede / cookie ---
# Origin exata do front (sem default). CORS espelha só ela; cookies dependem disto.
WEB_ORIGIN=http://localhost:5173
# Dev sob http: nome sem prefixo + false. Prod: __Host-rit_session + true — o prefixo
# __Host-/__Secure- exige COOKIE_SECURE=true, senão o browser descarta o cookie.
COOKIE_NAME=rit_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Cookie de device (agrupa sessões por aparelho; NÃO é credencial). Dev: sem prefixo.
# Prod: __Host-rit_device + COOKIE_SECURE=true (mesma regra do prefixo).
DEVICE_COOKIE_NAME=rit_device
# 400d (teto Chrome). Persistente, re-setado a cada login (sliding); logout não apaga.
DEVICE_COOKIE_TTL_SECONDS=34560000
# Hops de proxy confiáveis até o app (atrás de LB ajuste ao número real).
TRUST_PROXY_HOPS=1

# --- auth: sessão (segundos) ---
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_REMEMBER_IDLE_TTL_SECONDS=2592000
SESSION_MAX_PER_USER=20

# --- auth: tokens (segundos) ---
RESET_TOKEN_TTL_SECONDS=3600
VERIFY_TOKEN_TTL_SECONDS=86400
ACCESS_LINK_TOKEN_TTL_SECONDS=604800

# --- auth: argon2 (floors OWASP — boot aborta abaixo do mínimo) ---
ARGON_MEMORY_KIB=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=1
ARGON_HASH_LENGTH=32
ARGON_SALT_LENGTH=16

# --- auth: pepper + política de senha ---
# Segredo de servidor com >=32 chars. NUNCA versionar o valor real.
PASSWORD_PEPPER=troque-por-segredo-com-no-minimo-32-chars
PASSWORD_MIN_ZXCVBN_SCORE=3

# --- auth: breach check (sem default — escolha consciente) ---
BREACH_CHECK_MODE=fail_open
# Liga o HIBP real (request de rede). false em dev; true em prod.
BREACH_CHECK_ENABLED=false

# --- auth: mailer ---
# log = LogMailer (dev, registra o link). resend = ResendMailer (prod, exige
# RESEND_API_KEY e MAIL_FROM; link nunca vai pro log).
MAIL_TRANSPORT=log
# RESEND_API_KEY=re_xxx
# MAIL_FROM=no-reply@example.com

# --- auth: verificação / csrf / auditoria ---
REQUIRE_EMAIL_VERIFICATION=false
# Obrigatório só quando COOKIE_SAMESITE=none. >=32 chars.
CSRF_SECRET=troque-por-segredo-csrf-com-no-minimo-32-chars
SECURITY_AUDIT_RETENTION_DAYS=180

# --- rate-limit ---
# Redis é o backend único do rate-limit (não há backend Postgres). Obrigatório.
REDIS_URL=redis://localhost:6379

# --- storage (Cloudflare R2, S3-compat) ---
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=platform-dev
R2_ENDPOINT=https://changeme.r2.cloudflarestorage.com
# --- attachment ---
ATTACHMENT_MAX_UPLOAD_BYTES=5242880
ATTACHMENT_ACCESS_LOG_RETENTION_DAYS=180
