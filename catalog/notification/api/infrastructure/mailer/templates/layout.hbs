<!doctype html>
<html lang="pt-BR">
  <body style="margin:0;padding:0;background:{{theme.background}};font-family:{{theme.fontFamily}};color:{{theme.foreground}};">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{theme.background}};padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid {{theme.border}};border-radius:{{theme.radiusMd}};overflow:hidden;">
            <tr>
              <td style="padding:28px 32px;border-bottom:1px solid {{theme.border}};">
                <span style="font-size:20px;font-weight:700;color:{{theme.primary}};letter-spacing:-0.01em;">Platform</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;font-size:15px;line-height:1.6;">
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px;border-top:1px solid {{theme.border}};color:{{theme.muted}};font-size:12px;line-height:1.5;">
                <p style="margin:0;">Platform</p>
                <p style="margin:8px 0 0;">Se você não esperava este e-mail, pode ignorá-lo com segurança.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
